# Admin
ADMIN_TOKEN=admin_token_2024

# CORS (les origines par défaut incluent la production si non défini)
# Format: origine1,origine2,origine3 (sans slash final)
# Exemple: https://drivinnchill.fr,https://www.drivinnchill.fr,http://localhost:3000
# Laisser vide ou ne pas définir pour utiliser les valeurs par défaut (inclut la production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (optionnel - les emails seront simulés si non configuré)
